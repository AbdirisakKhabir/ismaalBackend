// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String
  phone       String?
  location    String?
  /// Profile photo URL (e.g. Cloudinary)
  image       String?  @db.Text
  /// Short bio / about text for the account profile
  description String?  @db.Text
  plan_id     Int      @default(1)
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  businesses            Business[]
  plan                  Plans?               @relation(fields: [plan_id], references: [id]) // Single relation
  products              Product[]
  professional          Professional?
  PlanUpgradeRequest    PlanUpgradeRequest[]
  transactions          Transaction[]
  passwordResetTokens   PasswordResetToken[]
}

model Plans {
  id                Int      @id @default(autoincrement())
  name              String
  description       String   @db.Text
  price             Decimal  @default(0)
  priceMonthly      Decimal  @default(0)
  priceYearly       Decimal  @default(0)
  allowedBusinesses Int      @default(1)
  allowedProducts   Int      @default(1)
  /// When true, subscribers may publish their professional profile to public listings. Business and product listings never use this flag.
  allowProfessionalPublish Boolean @default(true)
  users             User[] // Inverse relation
  userId            Int? // Remove this if not needed
  profile_status    String   @default("Not Approved")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  currentPlanRequests   PlanUpgradeRequest[] @relation("CurrentPlan")
  requestedPlanRequests PlanUpgradeRequest[] @relation("RequestedPlan")
  transactions          Transaction[]
}

model Business {
  id            Int      @id @default(autoincrement())
  name          String
  description   String   @db.Text
  category      String
  image         String?  @db.Text // ← Change to Text to store long URLs
  status        Status   @default(PENDING)
  owner         User     @relation(fields: [ownerId], references: [id])
  ownerId       Int
  phone         String
  email         String
  location      String
  submittedDate DateTime @default(now())
  businessType  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String   @db.Text
  // New Price Fields
  price         Decimal
  price_to      Decimal?
  price_option  String   @default("Fixed") // Fixed, Range, Negotiable, Crossed
  crossed_price Decimal? // Original price (Used for Crossed)

  // New Fields
  category    String // Comma-separated categories
  type        String @default("New") // New, Used, Refurbished
  posted_from String @default("Personal") // Personal, Business_ID, Professional_ID

  image         String?  @db.Text
  status        Status   @default(PENDING)
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  submittedDate DateTime @default(now())
  location        String
  /// What to show next to the product name on the public listing: "location" (default) or "category"
  listingDisplay String @default("location")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Add this enum if not already defined
enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model PlanUpgradeRequest {
  id              Int                  @id @default(autoincrement())
  user            User                 @relation(fields: [userId], references: [id])
  userId          Int
  currentPlan     Plans                @relation("CurrentPlan", fields: [currentPlanId], references: [id])
  currentPlanId   Int
  requestedPlan   Plans                @relation("RequestedPlan", fields: [requestedPlanId], references: [id])
  requestedPlanId Int
  amount          Decimal              @db.Decimal(11, 2)
  status          UpgradeRequestStatus @default(PENDING)
  paymentMethod   String
  transactionId   String?
  phoneNumber     String?
  screenshot      String? // Image of payment proof
  adminNotes      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Remove these duplicate fields:
  // Plans           Plans?               @relation(fields: [plansId], references: [id])
  // plansId         Int?
}

model Professional {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id])
  userId        Int      @unique
  profession    String
  specialty     String
  experience    String
  location      String
  phone         String
  email         String
  description   String? @db.Text // Long text; default String maps to VARCHAR(191) on MySQL and truncates long bios
  image         String?
  status        Status   @default(PENDING)
  /// Public directory visibility (requires approved status + plan.allowProfessionalPublish). Not used for business/product.
  published     Boolean  @default(true)
  submittedDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model SystemConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text

  @@map("system_config")
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
  // ... other status values
}

model Transaction {
  id            Int      @id @default(autoincrement())
  userId        Int
  planId        Int
  transactionId String   @unique
  productId     String
  amount        Float
  status        String   @default("COMPLETED")
  paymentMethod String   @default("APPLE_IAP")
  purchaseDate  DateTime @default(now())
  createdAt     DateTime @default(now())

  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plans @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

/// Managed list of cities (Somalia / Horn region + Other) for listings and forms
model LookupCity {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lookup_cities")
}

/// Categories by domain: business, product, or profession
model LookupCategory {
  id        Int      @id @default(autoincrement())
  name      String
  type      String // business | product | profession
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type])
  @@map("lookup_categories")
}
